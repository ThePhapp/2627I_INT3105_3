  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ReportStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "VERIFIED",
          "REJECTED"
        ]
      },
      "Id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "description": "Canonical lowercase UUID; server-generated for new resources."
      },
      "DisasterType": {
        "type": "string",
        "enum": [
          "EARTHQUAKE",
          "FLOOD",
          "TYPHOON",
          "WILDFIRE",
          "TSUNAMI"
        ]
      },
      "Report": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "reporterId": {
            "$ref": "#/components/schemas/Id"
          },
          "type": {
            "$ref": "#/components/schemas/DisasterType"
          },
          "description": {
            "$ref": "#/components/schemas/Description"
          },
          "latitude": {
            "$ref": "#/components/schemas/Latitude"
          },
          "longitude": {
            "$ref": "#/components/schemas/Longitude"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING"
            ]
          },
          "createdAt": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "required": [
          "id",
          "reporterId",
          "type",
          "description",
          "latitude",
          "longitude",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "description": "B1 PENDING report; no verification, withdrawal, persistence or mission fields.",
        "example": {
          "id": "00000000-0000-4000-8000-000000000005",
          "reporterId": "00000000-0000-4000-8000-000000000001",
          "type": "FLOOD",
          "description": "Water rising near the entrance",
          "latitude": 21.028,
          "longitude": 105.834,
          "status": "PENDING",
          "createdAt": "2026-10-08T03:00:00Z",
          "updatedAt": "2026-10-08T03:00:00Z"
        }
      },
      "CreateReportRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "$ref": "#/components/schemas/DisasterType"
          },
          "description": {
            "$ref": "#/components/schemas/Description"
          },
          "latitude": {
            "$ref": "#/components/schemas/Latitude"
          },
          "longitude": {
            "$ref": "#/components/schemas/Longitude"
          }
        },
        "required": [
          "type",
          "description",
          "latitude",
          "longitude"
        ],
        "example": {
          "type": "FLOOD",
          "description": "Water rising near the entrance",
          "latitude": 21.028,
          "longitude": 105.834
        }
      },
      "ReportPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Report"
            },
            "maxItems": 100
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "description": "Own PageResponse, never Spring Page. Counts after authorization and all filters, before pagination. totalPages=ceil(totalElements/size); empty total is 0 pages; page beyond end returns empty items, 200.",
        "example": {
          "items": [
            {
              "id": "00000000-0000-4000-8000-000000000005",
              "reporterId": "00000000-0000-4000-8000-000000000001",
              "type": "FLOOD",
              "description": "Water rising near the entrance",
              "latitude": 21.028,
              "longitude": 105.834,
              "status": "PENDING",
              "createdAt": "2026-10-08T03:00:00Z",
              "updatedAt": "2026-10-08T03:00:00Z"
            }
          ],
          "page": 0,
          "size": 20,
          "totalElements": 1,
          "totalPages": 1
        }
      },
