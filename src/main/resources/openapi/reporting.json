              "UNAUTHENTICATED",
              "INVALID_CREDENTIALS",
              "FORBIDDEN",
              "NOT_FOUND",
              "INVALID_TRANSITION",
              "STALE_VERSION",
              "DISASTER_NOT_ACTIVE",
              "REPORT_NOT_VERIFIED",
              "REPORT_ALREADY_ASSIGNED",
              "TEAM_BUSY",
              "UNSUPPORTED_MEDIA_TYPE",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
