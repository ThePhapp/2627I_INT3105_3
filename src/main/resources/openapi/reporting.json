            "maxItems": 100
          }
        },
        "required": [
          "timestamp",
          "status",
          "code",
          "message",
          "path",
          "fieldErrors"
        ],
        "description": "fieldErrors always present; [] except validation errors. path excludes query string. No stack trace, credentials or token.",
        "example": {
          "timestamp": "2026-10-08T03:00:00Z",
          "status": 409,
          "code": "TEAM_BUSY",
          "message": "Team already has an active mission.",
          "path": "/api/rescue-missions",
          "fieldErrors": []
        }
      },
      "Latitude": {
        "type": "number",
        "format": "double",
        "minimum": -90,
        "maximum": 90
      },
      "Longitude": {
        "type": "number",
        "format": "double",
