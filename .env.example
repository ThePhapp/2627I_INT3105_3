# Local development only: replace this placeholder before starting the database.
POSTGRES_DB=gdrn
POSTGRES_USER=gdrn
POSTGRES_PASSWORD=replace-with-a-local-password
DB_PORT=5432
APP_PORT=8080
# Host-run Spring Boot configuration; Compose supplies its own container hostname.
DB_URL=jdbc:postgresql://localhost:5432/gdrn
DB_USERNAME=gdrn
DB_PASSWORD=replace-with-a-local-password
# Identity: generate a random base64 key (at least 32 bytes); never use this placeholder.
JWT_SECRET_BASE64=replace-with-random-base64-key
# Optional controlled bootstrap: set local,demo on host or demo in Compose.
SPRING_PROFILES_ACTIVE=
DEMO_CITIZEN_ONE_EMAIL=
DEMO_CITIZEN_ONE_PASSWORD=
DEMO_CITIZEN_TWO_EMAIL=
DEMO_CITIZEN_TWO_PASSWORD=
DEMO_AUTHORITY_EMAIL=
DEMO_AUTHORITY_PASSWORD=
